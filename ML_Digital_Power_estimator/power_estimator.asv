%%---------------------------------------------------------
% VISUALIZATION 6: FREQUENCY DESGIN SPACE
%%---------------------------------------------------------

frequencyRange = lineSpace(50, 1000, 100)';

frequencyExperiment = repmat(newCircuitArray, 100, 1);

frequencyExperiment(:, 4) = frequencyRange;

frequencyFeatures = buildFeautureMatrix(frequencyExperiment, ...
    maodelPackage.FeatureMode);

frequencyPredictions = predictRidgeModel(modelPackage, ...
    featureFeatures);

figure("Name", "Frquency verus Power");
plot(frequencyRange, frequencyPredictions, "LineWidth", 1.5);

xlabel("Operating Frequency (Mhz)");
ylabel("PRedicted Dynamic Power (mW)");

title("Effect of Frequency on Dynamic Power");

grid on;

fprintf("Project execution completed successfully.\n");

%%------------------------------------------------------------
% LOCAL FUNCTION : GENERATE SYNTHETIC DATASET
%%------------------------------------------------------------

function dataset = generatePowerDataset(numberOfSamples)
    arguments

        numberOfSamples (1,1) double {mustBeInteger, mustBePositive}
    end

    % Switching activity between 1% and 50%
    switchingActivity = 0.01 + (0.50 - 0.01) .* rand(numberOfSamples, 1);

    % Gate count for small and medium digital blocks.
    gateCount = randi([1000, 50000], numberOfSamples, 1);

    % Effective capacitance is partially related to gate count.
    capacitiveVariance = 0.75 + (1.25 - 0.75) .* rand(numnberOfSamples, 1);
    capacitance_pF = 0.002 .* gateCount .* capacitiveVariance;

    % Supply voltage.
    voltage_V = 0.60 + (1.20 - 0.60) .* rand(numberOfSamples, 1);

    % Operating frequency
    frequency_MHz = 50 + (1000 - 50) .* rand(numberOfSamples, 1);

    % Average circuit fan-out
    fanOut = 1 + (5 - 1) .* rand(numberOfSamples, 1);

    % Operating temperatures.
    temperature_C = 25 + (100 - 25 ) .* rand(numberOfSamples, 1);

    % Simplefied semiconductor process variables.
    processFactor = 0.90 + (1.10 - 0.90) .* rand(numberOfSamples, 1);

    % Base dynamic power in milliwatts.
    basePower_mW = switchingActivity .* capacitance_pF .* ...
        voltage_V .^2 .* frequency_MHz .* 1e-3;

    % Fan-out correction.
    fanOutFactor = 1 + 0.04 .* (fanOut - 1);

    % Temperature correction.
    temperatureFactor = 1 + 0.0015 .* (temperature_C - 25);

    % Combine all effects.
    correctedPower_mW = basePower_mW .* fanOutFactor .* ...
        temperatureFactor .* processFactor;

    % Add approximately 3% observation noise.
    noiseStandardDeviation = 0.03 .* max(correctedPower_mW, eps);
    randomNoise = noiseStandardDeviation .* ...
        randn(numberOfSamples, 1);

    dynamicPower_mW = max(correctedPower_mW + randomNoise, 0);

    dataset =  table( ...
        switchingActivity, ...
        capacitance_pF, ...
        voltage_V, ...
        frequency_MHz, ...
        gateCount, ...
        fanOut, ...
        temperature_C, ...
        processFactor, ...
        dynamicPower_mW, ...
        "VariableNames", {
            "SwitchingActivity"
            "Capacitance_pF"
            "Voltage_V"
            "Frequency_MHz"
            "GateCount"
            "FanOut"
            "Temperature_C"
            "ProcessFactor"
            "DynamicPower_mW"
        });

end

%%---------------------------------------------------------
% LOCAL FUNCTION : BUILD FEATURE MATRIX
%%---------------------------------------------------------

function [features, featureNames] = buildFeatureMatirx(circuitInputs, ...
    featureMode);
    
    rawFeaturesNames = {
        "SwitchingActivity"
        "Capacitance_pF"
        "Voltage_V"
        "Frequency_MHz"
        "GateCount"
        "FanOut"
        "Temperature_C"
        "ProcessFactor"
    };

    if featureMode == "raw"
        features = circuitInputs;
        featureNames = rawFeatureNames;

        return;
    end

    alpha = circuitInputs(:, 1);
    capacitance = circuitInputs(:, 2);
    voltage = circuitInputs(:, 3);
    frequency = circuitInputs(:, 4);

    fanOut = circuitInputs(:, 6);
    temperature = circuitInputs(:, 7);
    processFactor = circuitInputs(:, 8);

    basePower_mW = alpha .* capacitance .* voltage.^2 .* ...
        frequency .* 1e-3;

    features = [
        circuitInputs
        basePower_mW
        basePower_mW .* fanOut
        basePower_mW .* temperature
        basePower_mW .* processFactor
        basePower_mW .* fanOut .* processFactor
        basePower_mW .* temperature .* processFactor
        basePower_mW .* fanOut .* temperature .* processFactor
    ];


    featureNames = [
        rawFeatureNames
        {
            "BasePower_mW"
            "BasePower_x_FanOut"
            "BasePower_x_Temperature"
            "BasePower_x_Process"
            "BasePower_x_FanOut_x_Process"
            "BasePower_x_Temperature_x_Process"
            "BasePower_x_FanOut_x_Temperature_x_Process"
        }
    ];

end

%%----------------------------------------------------------
% LOCAL FUNCTION : TRAIN RIDGE REGRESSION
%%----------------------------------------------------------

function model = fitRidgeModel(trainingFeatures, trainingFeatures, ...
    lambda, featureMode, featurenames);
    
    % Calculate features scaling parameters.
    featureMean = mean(trainingFeatures, 1);
    featureStandardDeviation = std(trainingFeatures, 0, 1);

    % Prevent division by Zero
    featureStandardDeviation(featureStandarDeviation == 0) = 1;

    standardizedFeatures = (trainingFeatures - featureMean) ./ ...
        featureStandardDeviation;

    % Add intercept column.
    designMatrix = [
        ones(size(standardizedFeatures, 1), 1), ...
        standardizedFeatures];

    % Do not regularize the intercept coefficient
    regularizationMatrix = ddiag(...
        [0 ...
        ones(size(standardaizedFeatures,2), 1) ...
        ]);

    coefficients = (...
        designMatrix' * designMatrix + lambda .* regularizationMatrix) \ ...
        (designMatix' * trainingTarget);

    model = struct();

    model.FeatureMode = featureMode;
    model.FeatureName = featureNames;

    model.Mu = featureMean;
    model.Sigma = featureStandardDeviation;
    model.Beta = coefficients;
    model.lambda = lambda;

end

%%--------------------------------------------------------
% LOCAL FUNCTION : PREDICT USING RIDGE MODEL    
%%--------------------------------------------------------

function predictions  = predictRidgeModel(model, features)
    standardizedFeatures = (features - model.Mu) ./ model.Sigma;

    designMatrix = [
        ones(size(standardizedFeatures, 1), 1)
        standardizedFeatures];

    predictions = designMatrix * model.Beta;

    % Power cannot be negative
    predictions = max(predictions, 0);

end

%%------------------------------------------------------------
%  LOCAL FUNCTION : CALCULATE REGRESSION METRICS
%%------------------------------------------------------------

function metrics = calculateegressionMetrics(atucalValues, predictedValues);

    actualValues = actual